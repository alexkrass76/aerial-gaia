<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="app.orchard.tv.DirectBootHomeActivity"
            android:exported="true"
            android:directBootAware="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <!-- GaiaOS/CVTE adds this category to physical Home and boot intents. -->
                <category android:name="android.intent.category.COMMON_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Coocaa's private Home category, which its firmware picks the launcher by (Skyworth
                 9S52_Q4A, Android 6, issue #397; also what makes Dangbei's launcher selectable there).
                 Not verified to change the boot launcher yet. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME.CC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
